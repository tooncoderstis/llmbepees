# Hub portofolio — pelaporan progres fase. Salin ke .env (JANGAN commit).
# Nilai HUB_INGEST_SECRET diambil dari .env repo "portofolio" (jangan ditulis di repo ini).
HUB_INGEST_URL=https://m-portofolio.hgteop.easypanel.host
HUB_INGEST_SECRET=

# Opsional (bila slug/nama proyek beda dari nama folder/package.json):
# HUB_PROJECT_SLUG=
# HUB_PROJECT_NAME=

# EasyPanel — deploy programatik (diisi saat Fase 12, JANGAN commit ke repo).
EASYPANEL_API_KEY=
